   "passages": [
    {
     "id": "nbc2-1",
     "speaker": "旁白",
     "speakerEn": "Narrator",
     "text": "孩子们钻进被窝，暖暖地躺好，梦里的糖果，蹦蹦又跳跳。",
     "textEn": "The children were nestled all snug in their beds,\nWhile visions of sugar-plums danced in their heads;",
     "audio": null
    },
    {
     "id": "nbc2-2",
     "speaker": "旁白",
     "speakerEn": "Narrator",
     "text": "妈妈包着头巾，我戴着睡帽，刚刚闭上眼，要睡个长长的觉——",
     "textEn": "And Mama in her kerchief, and I in my cap,\nHad just settled down for a long winter's nap,",
     "audio": null
    },
    {
     "id": "nbc2-3",
     "speaker": "旁白",
     "speakerEn": "Narrator",
     "text": "忽然，屋外“哗啦啦”一阵好大的响！",
     "textEn": "When out on the lawn there arose such a clatter,",
     "audio": null
    }
